ol curl # Transfer data wget # Retrieve content unzip # Archive utility tar # Archive utility gnupg # GPG tools procps # ps, top, etc. for process management coreutils # GNU core utilities (ls, cp, mv, etc.) # Multiple Shells for flexibility bash # Standard GNU Bash zsh # Z Shell fish # Friendly Interactive SHell nushell # Modern shell (if available for aarch64) # Terminal Multiplexer for session management tmux # Terminal Multiplexer # Also could include: screen # GNU Screen # --- Text Editors --- vim # Vi Improved neovim # Hyperextensible Vim-based text editor # nano # Simple text editor # --- Development Tools (Examples) --- python3 # Python environment nodejs # Node.js runtime go # Go programming language rustc # Rust compiler gnumake # Make utility gcc # GNU C Compiler gdb # GNU Debugger # clang # LLVM C/C++/ObjC compiler # cmake # Cross-platform build system generator # --- Emulators (CLI-focused, if available and practical) --- # Note: Full-blown retro game emulators with GUI might not work well # without a graphical environment set up in Termux. # This includes CLI emulators that might run within Termux. # dosbox # DOS emulator (might require X server for full use, but core is CLI) # qemu_full # QEMU emulator (complex, but can run various OSes in CLI) # bochs # x86 PC emulator (CLI only) # --- Other useful CLI tools --- htop # Interactive process viewer ncdu # Disk usage analyzer ripgrep # Fast grep alternative fd # Fast find alternative delta # Syntax-highlighting diff bat # Cat clone with syntax highlighting and Git integration jq # JSON processor yq # YAML processor fzf # Fuzzy finder lazygit # Terminal UI for Git lazydocker # Terminal UI for Docker (if Docker were running, usually not in Termux) # ncdu # Disk usage analyzer # micro # Modern terminal-based text editor ]; # Define environment variables or functions for the shell. shellHook = '' export PS1="[033[1;34m]nix-termux[033[0m]:w$ " echo "------------------------------------------------------------